# --- Secrets (copy to .env and fill in) ---
OPENAI_API_KEY=sk-...
LANGSMITH_API_KEY=lsv2_pt_...

# --- LangSmith tracing ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=SimpleRAG

# --- Vector store ---
# CHROMA (embedded, no server) or QDRANT (requires a running server)
VECTOR_DB=QDRANT
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# --- Indexing ---
# Set to true to wipe the collection before re-indexing
RESET_VECTOR_STORE=true

# --- Embeddings ---
# "openai" (text-embedding-3-large, best quality, needs OPENAI_API_KEY)
# or "local" (sentence-transformers, free/offline, slower on CPU).
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL_NAME=text-embedding-3-large
# EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2   # for EMBEDDING_PROVIDER=local
# EMBEDDING_BATCH_SIZE=64
# EMBEDDING_MAX_RETRIES=3

# --- Chunking ---
# "hybrid" (LLM topic boundaries + semantic fallback), "semantic" (no LLM,
# embedding-similarity boundaries), or "size" (plain).
CHUNK_STRATEGY=hybrid
# CHUNK_MAX_SIZE=1200
# CHUNK_BATCH_SIZE=25
# CHUNK_MIN_LENGTH=100
# CHUNK_CONTEXT_PREFIX=true

# --- Hybrid retrieval + reranking ---
HYBRID_SEARCH=true
HYBRID_TOP_K=50
# RRF_K=60
RERANK_ENABLED=true
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
# RERANK_MIN_SCORE=0.0

# --- Generation ---
# LLM_MODEL=gpt-4o-mini
# LLM_TEMPERATURE=0.1
# LLM_MAX_TOKENS=2048
# MAX_HISTORY_TURNS=6
# DEFAULT_TOP_K=5
# DEFAULT_SCORE_THRESHOLD=0.0

# --- Optional overrides ---
# COLLECTION_NAME=Kamakshi
